<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Bench</RootNamespace>

        <!-- Server GC is what a real ASP.NET Core / gRPC host gets by default, because those
             projects use Microsoft.NET.Sdk.Web. This project uses the plain SDK, so without this
             it would silently fall back to workstation GC and the server would not resemble a
             production deployment. Set explicitly so the benchmark measures what it claims to.
             It applies to both targets equally: -target wcf and -target grpc are the same
             executable, so the WCF-vs-gRPC comparison stays symmetric. -->
        <ServerGarbageCollection>true</ServerGarbageCollection>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="CoreWCF.Http" Version="1.9.1" />
      <PackageReference Include="CoreWCF.NetTcp" Version="1.9.1" />
      <PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.84.0" />
      <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
      <PackageReference Include="Grpc.Tools" Version="2.84.0">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <None Remove="grpc\proto\Northwind.proto" />
      <Protobuf Include="grpc\proto\Northwind.proto">
        <Generator>MSBuild:Compile</Generator>
      </Protobuf>
    </ItemGroup>

</Project>
