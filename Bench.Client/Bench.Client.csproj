<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- The client deserializes multi-megabyte responses and, on the batch operation, allocates at
             roughly 1.3 GB/s. On the default workstation GC that rate with 20+ concurrent workers makes
             the gen2 budget heuristic stop scheduling gen2 collections altogether: measured on the
             gRPC batch sweep, c=10 did 356 gen2 collections in 10s and held 129 MB, while c=15..40 did
             ONE each and accumulated ~8 GB of dead object graph. A forced full GC returned that to
             ~120 MB, so nothing leaked - the GC had simply stopped reclaiming. With Server GC the
             same run peaks at 793 MB and completes ~6x more calls.
             The trade is a higher floor: per-core heaps are reserved up front, so resident memory after
             a full GC sits around 0.4-1.2 GB instead of ~120 MB. Bounded beats spiky. -->
        <ServerGarbageCollection>true</ServerGarbageCollection>
    </PropertyGroup>

    <ItemGroup>
      <!-- Proto is compiled (not just copied) so the gRPC client (Northwind.NorthwindService.NorthwindServiceClient) is generated. -->
      <None Remove="..\Bench.Server\grpc\proto\Northwind.proto" />
      <Protobuf Include="..\Bench.Server\grpc\proto\Northwind.proto">
        <Link>gRPC\Northwind.proto</Link>
        <Generator>MSBuild:Compile</Generator>
      </Protobuf>
    </ItemGroup>

    <ItemGroup>
      <!-- Linked so the client resolves the batch count with OrderData.ResolveCount, the same
         function the server uses. Duplicating the rule would let the two drift apart. -->
    <Compile Include="..\Bench.Server\OrderData.cs">
      <Link>OrderData.cs</Link>
    </Compile>
    <Compile Include="..\Bench.Server\wcf\DataContracts\Customer.cs">
        <Link>wcf\DataContracts\Customer.cs</Link>
      </Compile>
      <Compile Include="..\Bench.Server\wcf\DataContracts\Order.cs">
        <Link>wcf\DataContracts\Order.cs</Link>
      </Compile>
      <Compile Include="..\Bench.Server\wcf\DataContracts\OrderDetail.cs">
        <Link>wcf\DataContracts\OrderDetail.cs</Link>
      </Compile>
      <Compile Include="..\Bench.Server\wcf\DataContracts\OrderRequest.cs">
        <Link>wcf\DataContracts\OrderRequest.cs</Link>
      </Compile>
      <Compile Include="..\Bench.Server\wcf\DataContracts\OrdersRequest.cs">
        <Link>wcf\DataContracts\OrdersRequest.cs</Link>
      </Compile>
      <Compile Include="..\Bench.Server\wcf\DataContracts\OrdersResponse.cs">
        <Link>wcf\DataContracts\OrdersResponse.cs</Link>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <!-- WCF client proxy generated from http://localhost:5000/NorthwindWcfService/basic?wsdl via dotnet-svcutil. -->
      <!-- NorthwindServiceClient.cs is auto-included by the SDK (project dir). Params file tracked so regeneration is reproducible. -->
      <!-- Regenerate with: dotnet-svcutil http://localhost:5000/NorthwindWcfService/basic?wsdl -d wcf/ServiceReference -o NorthwindServiceClient.cs -n 'http://tempuri.org/,Bench.Client.Wcf' -ct System.Collections.Generic.List`1 -ser DataContractSerializer -r Bench.Client.csproj -->
      <None Include="wcf\ServiceReference\dotnet-svcutil.params.json" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CoreWCF.Http" Version="1.9.1" />
      <PackageReference Include="CoreWCF.NetTcp" Version="1.9.1" />
      <PackageReference Include="Google.Protobuf" Version="3.36.2" />
      <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
      <PackageReference Include="Grpc.Tools" Version="2.84.0">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="System.ServiceModel.Http" Version="10.0.652802" />
      <PackageReference Include="System.ServiceModel.NetTcp" Version="10.0.652802" />
    </ItemGroup>

</Project>